# Copy this file to .env.local and fill in only the keys you intend to use.
# .env.local is gitignored. Never commit real keys or secret keys.

# Preferred image provider: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Optional provider for locally optimised WebP photos: https://www.pexels.com/api/documentation/
PEXELS_API_KEY=

# Optional provider for locally stored WebP photos: https://pixabay.com/api/docs/
# Pixabay forbids permanent hotlinking; photos are downloaded and credited.
PIXABAY_API_KEY=

# Optional future image-generation provider; generated art is labelled illustrative.
IMAGE_GENERATION_API_KEY=

# Phase 4 backend (local defaults: data/soko.sqlite and port 3001).
SOKO_DB_PATH=
PORT=
SESSION_SECRET=
